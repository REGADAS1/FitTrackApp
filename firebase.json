{
  "hosting": [
    {
      "target": "adpro",
      "public": "build/web",
      "ignore": ["firebase.json","**/.*","**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "default",
      "public": "build/web_default",
      "ignore": ["firebase.json","**/.*","**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ]
}

